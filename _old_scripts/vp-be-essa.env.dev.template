# OCR_INVOICE_EXTRACT_SCALE=
# OCR_BERITA_ACARA_EXTRACT_SCALE=
# OCR_BERITA_MAX_TOKENS=
# AP_DOCUMENT_MAX_SIZE_MB=
# AP_OCR_EXTRACT_URL=
# AP_OCR_HEALTH_URL=
# AP_OCR_EXTRACT_TIMEOUT_MS=
# AP_OCR_HEARTBEAT_MS=

# ---- Cloudinary (media uploads) ----
