# =============================================================================
# vp-be-essa  —  .env.dev  TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file into the backend repo as:   vp-be-essa/.env.dev
# (run-local.command does this automatically on first run if it is missing)
#
# Values marked <REQUIRED> must come from your team / DevOps — they are NOT in
# the repo. In particular the DB password is stored ENCRYPTED (aes-256-cbc,
# format "ivHex:encryptedHex") and is decrypted at runtime using
# DB_ENCRYPTION_KEY. You cannot invent these; get them from whoever owns the
# ESSA database.
# =============================================================================

# ---- App ----
NODE_ENV=development
PORT=8000
BASE_URL=http://localhost:8000
FE_URL=http://localhost:3000

# ---- Database (Microsoft SQL Server / mssql) ----
DB_HOST=<REQUIRED: db host, e.g. localhost or a server address>
DB_PORT=1433
DATABASE_NAME=<REQUIRED: database name>
DB_USER_NAME=<REQUIRED: db username>
# Encrypted password in the form  ivHex:encryptedHex
DB_PASSWORD=<REQUIRED: encrypted db password>
# Secret used to decrypt DB_PASSWORD above
DB_ENCRYPTION_KEY=<REQUIRED: db encryption key>
DB_REQUEST_TIMEOUT_MS=1800000

# ---- Auth / JWT ----
JWT_SECRET=<REQUIRED: any strong random string>
TOKAN_EXPIRY=1d
REMENBER_ME_TOKAN_EXPIRY=7d

# ---- Request/response encryption (set to false for easy local testing) ----
REQ_DECRYPTION=false
RES_ENCRYPTION=false

# ---- File storage ----
VENDOR_FOLDER_PATH=./data/ses-documents

# =============================================================================
# Everything below is OPTIONAL — only needed for the related feature.
# Leave blank/commented if you are not testing that feature locally.
# =============================================================================

# ---- OpenAI (OCR / AP document extraction) ----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# OPENAI_TIMEOUT_MS=

# ---- OCR tuning (safe defaults; only change if needed) ----
# OCR_MAX_PAGES=
