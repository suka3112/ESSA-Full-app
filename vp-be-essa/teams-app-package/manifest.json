{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "Vendor Portal",
    "websiteUrl": "https://localhost:8000",
    "privacyUrl": "https://localhost:8000/privacy",
    "termsOfUseUrl": "https://localhost:8000/termsofuse"
  },
  "name": {
    "short": "Approval Bot",
    "full": "Vendor Portal Approval Bot"
  },
  "description": {
    "short": "Personal 1:1 approval bot (dev)",
    "full": "Sideload prototype for Teams 1:1 chat: echo messages and test Adaptive Card approve/reject actions."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#464EB8",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
