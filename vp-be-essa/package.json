{
  "name": "Vendor-Portal",
  "version": "1.0.0",
  "description": "Vendor Portal",
  "scripts": {
    "start": "npx dotenv -e .env -- ts-node src/index.ts",
    "build": "tsc",
    "dev": "npx dotenv -e .env.dev -- nodemon --exec ts-node src/index.ts --max-old-space-size=8000",
    "prod": "npx dotenv -e .env -- nodemon --exec ts-node src/index.ts --max-old-space-size=8000",
    "lint": "eslint . --ext .ts",
    "seed:essa-users": "npx dotenv -e .env.dev -- npx ts-node db/seed-essa-ap-users.ts",
    "seed:email-templates": "npx dotenv -e .env.dev -- npx ts-node db/seed-email-templates.ts",
    "seed:email-templates:undo": "npx dotenv -e .env.dev -- npx ts-node db/seed-email-templates.ts --undo",
    "seed:nonpo": "npx dotenv -e .env.dev -- npx ts-node db/seed-non-po-demo.ts",
    "auth:outlook-graph": "npx dotenv -e .env.dev -- npx ts-node db/outlook-graph-auth.ts",
    "migrate:sql": "npx dotenv -e .env.dev -- npx ts-node db/run-sql-migration.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "ocr-engine"
    ],
    "ext": "ts,js,json",
    "exec": "ts-node src/index.ts"
  },
  "keywords": [],
  "author": "Prasanna",
  "license": "ISC",
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@napi-rs/canvas": "^0.1.80",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.3.0",
    "botbuilder": "^4.23.3",
    "cloudinary": "^2.6.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "country-state-city": "^3.2.1",
    "crypto-js": "^4.2.0",
    "currency-codes": "^2.2.0",
    "currency-symbol-map": "^5.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "extract-zip": "^2.0.1",
    "form-data": "^4.0.6",
    "fs-extra": "^11.3.2",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "ldapjs": "^3.0.7",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.0",
    "nodemailer": "^6.10.0",
    "openai": "^6.42.0",
    "openid-client": "^5.7.1",
    "papaparse": "^5.5.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0",
    "pg-boss": "^12.30.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
