    "start:avensys": "cross-env REACT_APP_BRAND=avensys react-scripts start",
    "build:daikin": "cross-env REACT_APP_BRAND=daikin react-scripts build",
    "build:avensys": "cross-env REACT_APP_BRAND=avensys react-scripts build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
